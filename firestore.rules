rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guest_book/{id} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create: if request.resource.data.keys().hasAll(['guest_name', 'message', 'create_date', 'avatar_color'])
        && request.resource.data.keys().hasOnly(['guest_name', 'message', 'create_date', 'avatar_color'])
        && request.resource.data.guest_name is string
        && request.resource.data.guest_name.size() >= 1
        && request.resource.data.guest_name.size() <= 80
        && request.resource.data.guest_name.matches('.*[^\\s].*')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 1000
        && request.resource.data.message.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.avatar_color in ['#e8a0b5', '#f0b7c4', '#d4849c', '#f3c6d0', '#c98aa0', '#a64e6b', '#776098', '#497c78', '#996638', '#526e9c']
        && request.resource.data.create_date == request.time;
      allow update, delete: if false;
    }
  }
}

{
  "name": "starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/wedding.test.mjs",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-quan-huong \"node --test tests/firestore.test.mjs\"",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-quan-huong \"node --test tests/firestore.test.mjs && playwright test --config playwright.firebase.config.mjs\"",
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "optimize-images": "node scripts/optimize-images.mjs",
    "prepare-wedding-images": "node scripts/prepare-wedding-images.mjs",
    "json-server": "json-server --watch db.json --port 3031"
  },
  "dependencies": {
    "@emailjs/browser": "^3.11.0",
    "@fancyapps/ui": "^5.0.36",
    "animate.css": "^4.1.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "firebase": "^11.2.0",
    "framer-motion": "^10.16.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-pageflip": "^2.0.3",
    "react-photo-album": "^3.0.2",
    "sass": "^1.68.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "4.0.3",
    "eslint": "8.45.0",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.3",
    "firebase-tools": "^15.31.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "vite": "^4.5.5"
  }
}
